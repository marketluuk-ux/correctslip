# A real Postgres connection string — a free Neon/Supabase project, Docker,
# or (once deployed) the same database Render provisions for this app.
DATABASE_URL="postgresql://user:password@localhost:5432/correctslip"

# Single-admin passcode for /admin. Change this before deploying.
ADMIN_PASSWORD="change-me"

# Used to resolve absolute URLs for the share-preview image. Set to your
# real domain in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Random long string used to sign the admin session cookie.
SESSION_SECRET="change-me-too-a-long-random-string"

# Web Push keypair — generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Not a third-party account; just a keypair proving pushes came from this server.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Optional: if set, POST /api/cron/rotate-pick requires this as a Bearer
# token. Only needed if you point an external scheduler at that route
# (see README) — the in-process scheduler doesn't use it.
CRON_SECRET=""
